{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesktopPet",
  "version": "0.1.0",
  "identifier": "com.thejat.desktoppet",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pet",
        "url": "pet.html",
        "title": "DesktopPet",
        "width": 240,
        "height": 258,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "dashboard",
        "url": "dashboard.html",
        "title": "DesktopPet Dashboard",
        "width": 980,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../pets/": "pets/"
    }
  }
}
